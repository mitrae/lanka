# Development (pnpm dev) — reads from the repo working dir.
DATABASE_URL=file:./data/signage.db
MEDIA_DIR=./data/media
PORT=3000

# Media storage: Cloudflare R2 (optional). If ALL four are set, media is stored
# in R2 instead of MEDIA_DIR. The server still serves /media/<sha> over the
# tailnet (it proxies R2 — players never touch the public internet, and R2 has
# no egress fees). Leave unset to use local disk (MEDIA_DIR).
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=lanka-media
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...

# Production (.env on the host; rendered by scripts/render-env.sh
# as part of the lanka.service systemd unit — do not edit by hand
# in production). Only these three values live in .env in prod;
# DATABASE_URL + MEDIA_DIR for the container are hard-set in
# docker-compose.yml because the container paths never vary.
#
# HOST=100.x.y.z        # from `tailscale ip -4`
# PORT=3000
# TZ=Europe/Kyiv
#
# If using R2 in prod, add the four R2_* vars above to this .env too — they are
# passed straight into the container via `env_file: .env` in docker-compose.yml.
